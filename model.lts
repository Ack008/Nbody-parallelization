const N = 2
range B  = 0..N-1
range BI = 0..N          // include N come sentinella di fine

BODY(I=0) = (
	get_x[I] -> BODY
	|get_y[I] -> BODY
	|apply_force[I] -> get_vel_x[I] -> set_vel_x[I] -> get_vel_y[I] -> set_vel_y[I] -> BODY
	|end_step -> get_pos_x[I] -> set_pos_x[I] -> get_pos_y[I] -> set_pos_y[I] -> BODY
).

SIMULATOR = SIM[0],
SIM[b:BI] = (
	when (b < N)  simulate[b] -> PAIRS[b][0]
	|when (b == N) end_step -> get_pos_x[b] -> set_pos_x[b] -> get_pos_y[b] -> set_pos_y[b] -> SIMULATOR
),
PAIRS[b:B][o:BI] = if (o < N && o == b) then PAIRS[b][o+1] else NEXT[b][o],
NEXT[b:B][o:BI] = (
	when (o == N) apply_force[b] -> get_vel_x[b] -> set_vel_x[b] -> get_vel_y[b] -> set_vel_y[b]-> SIM[b+1]
	|when (o < N) get_x[b] -> get_x[o] -> get_y[b] -> get_y[o] -> PAIRS[b][o+1]
).

||SIMULATION = (a:BODY(0) || b:BODY(1) || {a,b}::SIMULATOR).